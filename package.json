{
  "name": "@tetherto/wdk-wallet-multisig-safe",
  "version": "1.0.0-beta.1",
  "description": "Safe multisig wallet module for WDK (Wallet Development Kit) by Tether, with ERC-4337 account abstraction for EVM networks.",
  "homepage": "https://docs.wdk.tether.io/",
  "keywords": [
    "wdk",
    "wallet",
    "multisig",
    "safe",
    "gnosis",
    "erc-4337",
    "account-abstraction",
    "ethereum"
  ],
  "author": "Tether",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/tetherto/wdk-wallet-multisig-safe.git"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "scripts": {
    "build:types": "tsc",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns tests/integration",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns tests/integration --coverage",
    "test:integration-wait": "wait-on http://localhost:8545 && cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand --forceExit",
    "test:integration": "concurrently -k -s first -n \"NODE,TEST\" -c \"black,green\" --hide NODE \"npx hardhat node\" \"npm run test:integration-wait\""
  },
  "dependencies": {
    "@safe-global/api-kit": "4.0.1",
    "@tetherto/wdk-wallet": "1.0.0-beta.19",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.16",
    "abstractionkit": "0.3.8",
    "bare-fetch": "2.7.1",
    "bare-node-runtime": "1.1.4",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.1.0",
    "@pimlico/alto": "0.0.19",
    "@pimlico/mock-paymaster": "0.0.4",
    "concurrently": "9.2.0",
    "cross-env": "7.0.3",
    "dotenv": "17.2.3",
    "hardhat": "3.17.0",
    "jest": "29.7.0",
    "prool": "0.0.23",
    "standard": "17.1.2",
    "typescript": "5.8.3",
    "wait-on": "8.0.4"
  },
  "overrides": {
    "tar": "7.5.22",
    "tmp": "0.2.7",
    "serialize-javascript": "7.1.0",
    "uuid": "11.1.1",
    "undici": "8.10.0",
    "adm-zip": "0.6.0",
    "protobufjs": "8.7.2"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "bare-node.js",
      "tests/**/*.js"
    ]
  }
}
